FROM libfabric-gpu AS nccl-gpu

ARG NCCL_PACKAGE_VERSION=2.29.7-1+cuda13.2
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libnccl2=${NCCL_PACKAGE_VERSION} \
        libnccl-dev=${NCCL_PACKAGE_VERSION} \
    && rm -rf /var/lib/apt/lists/*

ARG AWS_OFI_NCCL_VERSION=1.19.0
RUN wget -q https://github.com/aws/aws-ofi-nccl/releases/download/v${AWS_OFI_NCCL_VERSION}/aws-ofi-nccl-${AWS_OFI_NCCL_VERSION}.tar.gz \
    && tar xf aws-ofi-nccl-${AWS_OFI_NCCL_VERSION}.tar.gz \
    && cd aws-ofi-nccl-${AWS_OFI_NCCL_VERSION} \
    && ./configure --prefix=/usr --with-cuda=/usr/local/cuda --disable-tests \
    && make -j$(nproc) \
    && make install \
    && ldconfig \
    && cd .. \
    && rm -rf aws-ofi-nccl-${AWS_OFI_NCCL_VERSION}.tar.gz aws-ofi-nccl-${AWS_OFI_NCCL_VERSION}

ARG NCCL_TESTS_VERSION=2.17.1
RUN wget -q -O nccl-tests-${NCCL_TESTS_VERSION}.tar.gz https://github.com/NVIDIA/nccl-tests/archive/refs/tags/v${NCCL_TESTS_VERSION}.tar.gz \
    && tar xf nccl-tests-${NCCL_TESTS_VERSION}.tar.gz \
    && cd nccl-tests-${NCCL_TESTS_VERSION} \
    && make -j$(nproc) MPI=0 NVCC_GENCODE="-gencode=arch=compute_80,code=sm_80" \
    && mkdir -p /opt/nccl-tests \
    && cp -a build /opt/nccl-tests/ \
    && cd .. \
    && rm -rf nccl-tests-${NCCL_TESTS_VERSION}.tar.gz nccl-tests-${NCCL_TESTS_VERSION}

ENV NCCL_NET=AWS\ Libfabric
ENV NCCL_CROSS_NIC=1
ENV NCCL_SOCKET_IFNAME=hsn
ENV NCCL_NET_GDR_LEVEL=PHB
ENV NCCL_NCHANNELS_PER_NET_PEER=4
ENV FI_CXI_DISABLE_HOST_REGISTER=1
ENV FI_MR_CACHE_MONITOR=userfaultfd

FROM nccl-gpu AS nvshmem-gpu

ARG NVSHMEM_PACKAGE_VERSION=3.6.5-1
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libpciaccess0 \
        libnvshmem3-cuda-13=${NVSHMEM_PACKAGE_VERSION} \
        libnvshmem3-dev-cuda-13=${NVSHMEM_PACKAGE_VERSION} \
        libnvshmem3-static-cuda-13=${NVSHMEM_PACKAGE_VERSION} \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /opt/nvshmem /opt/nvshmem-tests \
    && ln -s /usr/bin/nvshmem_13 /opt/nvshmem/bin \
    && ln -s /usr/include/nvshmem_13 /opt/nvshmem/include \
    && ln -s /usr/lib/x86_64-linux-gnu/nvshmem/13 /opt/nvshmem/lib \
    && rm -f /opt/nvshmem/lib/nvshmem_bootstrap_mpi.so* \
       /opt/nvshmem/lib/nvshmem_bootstrap_shmem.so* \
       /opt/nvshmem/lib/nvshmem_transport_ibdevx.so* \
       /opt/nvshmem/lib/nvshmem_transport_ibgda.so* \
       /opt/nvshmem/lib/nvshmem_transport_ibrc.so* \
       /opt/nvshmem/lib/nvshmem_transport_ucx.so*

COPY tests/nvshmem_hello.cu /tmp/nvshmem_hello.cu
RUN nvcc -rdc=true -ccbin g++ -gencode=arch=compute_80,code=sm_80 \
       -I/opt/nvshmem/include /tmp/nvshmem_hello.cu \
       -o /opt/nvshmem-tests/nvshmem_hello \
       -L/opt/nvshmem/lib -lnvshmem_host -lnvshmem_device \
       -Xlinker -rpath -Xlinker /opt/nvshmem/lib \
    && ldconfig \
    && rm -f /tmp/nvshmem_hello.cu

ENV NVSHMEM_HOME=/opt/nvshmem
ENV PATH=/opt/nvshmem/bin:${PATH}
ENV LD_LIBRARY_PATH=/opt/nvshmem/lib:${LD_LIBRARY_PATH}
ENV NVSHMEM_BOOTSTRAP=PMI
ENV NVSHMEM_BOOTSTRAP_PMI=PMIX
ENV NVSHMEM_REMOTE_TRANSPORT=libfabric
ENV NVSHMEM_LIBFABRIC_PROVIDER=cxi
ENV NVSHMEM_DISABLE_CUDA_VMM=1
