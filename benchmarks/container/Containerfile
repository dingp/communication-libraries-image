FROM ${BASE_IMAGE_REPO}:openmpi-ofi-ucx-gpu AS bench-nccl-gpu
ARG AWS_OFI_NCCL_VERSION
ARG NCCL_TESTS_VERSION
RUN apt-get update \
    && apt-get install -y --no-install-recommends libnccl2 libnccl-dev \
    && rm -rf /var/lib/apt/lists/*
RUN wget -q https://github.com/aws/aws-ofi-nccl/releases/download/v${AWS_OFI_NCCL_VERSION}/aws-ofi-nccl-${AWS_OFI_NCCL_VERSION}.tar.gz \
    && tar xf aws-ofi-nccl-${AWS_OFI_NCCL_VERSION}.tar.gz \
    && cd aws-ofi-nccl-${AWS_OFI_NCCL_VERSION} \
    && ./configure --prefix=/usr --with-cuda=/usr/local/cuda --with-mpi=/usr --disable-tests \
    && make -j$(nproc) \
    && make install \
    && ldconfig \
    && cd .. \
    && rm -rf aws-ofi-nccl-${AWS_OFI_NCCL_VERSION}.tar.gz aws-ofi-nccl-${AWS_OFI_NCCL_VERSION}
RUN wget -q -O nccl-tests-${NCCL_TESTS_VERSION}.tar.gz https://github.com/NVIDIA/nccl-tests/archive/refs/tags/v${NCCL_TESTS_VERSION}.tar.gz \
    && tar xf nccl-tests-${NCCL_TESTS_VERSION}.tar.gz \
    && cd nccl-tests-${NCCL_TESTS_VERSION} \
    && make -j$(nproc) MPI=1 MPI_HOME=/usr NVCC_GENCODE="-gencode=arch=compute_80,code=sm_80" \
    && mkdir -p /opt/nccl-tests \
    && cp -a build /opt/nccl-tests/ \
    && cd .. \
    && rm -rf nccl-tests-${NCCL_TESTS_VERSION}.tar.gz nccl-tests-${NCCL_TESTS_VERSION}
ENV NCCL_NET=AWS\ Libfabric
ENV NCCL_CROSS_NIC=1
ENV NCCL_SOCKET_IFNAME=hsn
ENV NCCL_NET_GDR_LEVEL=PHB
ENV NCCL_NCHANNELS_PER_NET_PEER=4
ENV FI_CXI_DISABLE_HOST_REGISTER=1
ENV FI_MR_CACHE_MONITOR=userfaultfd
WORKDIR /opt/nccl-tests/build

FROM ${BASE_IMAGE_REPO}:nvshmem-gpu AS bench-nvshmem-gpu
RUN test -x /opt/nvshmem/bin/perftest/device/coll/alltoall_latency
WORKDIR /opt/nvshmem/bin/perftest/device/coll
