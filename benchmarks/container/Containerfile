ARG BASE_IMAGE_REPO=ghcr.io/dingp/communication-libraries-image
ARG OSU_VERSION=7.5.2
ARG AWS_OFI_NCCL_VERSION=1.19.0
ARG NCCL_TESTS_VERSION=2.17.1

FROM ${BASE_IMAGE_REPO}:mpich-cpu AS bench-mpich-cpu
ARG OSU_VERSION
RUN wget -q -O osu-micro-benchmarks.tar.gz https://mvapich.cse.ohio-state.edu/download/mvapich/osu-micro-benchmarks-${OSU_VERSION}.tar.gz \
    || wget -q -O osu-micro-benchmarks.tar.gz http://mvapich.cse.ohio-state.edu/download/mvapich/osu-micro-benchmarks-${OSU_VERSION}.tar.gz \
    || wget -q -O osu-micro-benchmarks.tar.gz http://mvapich.cse.ohio-state.edu/download/mvapich/osu-micro-benchmarks-v${OSU_VERSION}.tar.gz \
    && tar --no-same-owner -xf osu-micro-benchmarks.tar.gz \
    && cd osu-micro-benchmarks-* \
    && ./configure --prefix=/usr/local CC="$(command -v mpicc)" CFLAGS="-O3" \
    && make -j$(nproc) \
    && make install \
    && cd .. \
    && rm -rf osu-micro-benchmarks-* osu-micro-benchmarks.tar.gz
WORKDIR /usr/local/libexec/osu-micro-benchmarks/mpi

FROM ${BASE_IMAGE_REPO}:mpich-gpu AS bench-mpich-gpu
ARG OSU_VERSION
RUN echo /usr/local/cuda/lib64/stubs > /etc/ld.so.conf.d/cuda-stubs.conf \
    && ldconfig \
    && wget -q -O osu-micro-benchmarks.tar.gz https://mvapich.cse.ohio-state.edu/download/mvapich/osu-micro-benchmarks-${OSU_VERSION}.tar.gz \
    || wget -q -O osu-micro-benchmarks.tar.gz http://mvapich.cse.ohio-state.edu/download/mvapich/osu-micro-benchmarks-${OSU_VERSION}.tar.gz \
    || wget -q -O osu-micro-benchmarks.tar.gz http://mvapich.cse.ohio-state.edu/download/mvapich/osu-micro-benchmarks-v${OSU_VERSION}.tar.gz \
    && tar --no-same-owner -xf osu-micro-benchmarks.tar.gz \
    && cd osu-micro-benchmarks-* \
    && ./configure --prefix=/usr/local CC="$(command -v mpicc)" CFLAGS="-O3" \
       --enable-cuda \
       --with-cuda-include=/usr/local/cuda/include \
       --with-cuda-libpath=/usr/local/cuda/lib64 \
    && make -j$(nproc) \
    && make install \
    && cd .. \
    && rm -rf osu-micro-benchmarks-* osu-micro-benchmarks.tar.gz /etc/ld.so.conf.d/cuda-stubs.conf \
    && ldconfig
WORKDIR /usr/local/libexec/osu-micro-benchmarks/mpi

FROM ${BASE_IMAGE_REPO}:openmpi-cpu AS bench-openmpi-cpu
ARG OSU_VERSION
RUN wget -q -O osu-micro-benchmarks.tar.gz https://mvapich.cse.ohio-state.edu/download/mvapich/osu-micro-benchmarks-${OSU_VERSION}.tar.gz \
